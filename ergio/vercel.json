{
  "functions": {
    "api/[[...route]].js": {
      "maxDuration": 120
    },
    "api/setup.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/setup",
      "destination": "/api/setup"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/[[...route]]"
    },
    {
      "source": "/s/:slug",
      "destination": "/site.html"
    },
    {
      "source": "/site/:slug",
      "destination": "/site.html"
    },
    {
      "source": "/preview",
      "destination": "/build.html"
    }
  ]
}